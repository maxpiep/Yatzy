# Kniffel Club – Umgebungsvariablen (Vite liest nur Variablen mit VITE_-Präfix ins Frontend)
# Kopieren nach .env.local und mit den Werten aus dem Supabase-Dashboard füllen:
# Project Settings → API → Project URL / anon public key.
#
# WICHTIG: Niemals den service_role-Key hier eintragen. Der anon-Key ist öffentlich
# und durch Row Level Security abgesichert.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: "local" erzwingt den lokalen Einzelgeräte-Modus (ohne Supabase, ohne Sync).
# VITE_BACKEND_MODE=local

# Nur für die Datenbanktests (npm run test:db) – lokale PostgreSQL-Instanz, keine Produktion!
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
